---
import type { EducationEntry } from '../data/education';
interface Props {
  entry: EducationEntry;
}
const { entry } = Astro.props;
---
<div
  class="min-w-0 rounded-2xl border border-elevated bg-surface p-4 shadow-card transition-shadow duration-300 hover:shadow-xl sm:p-5"
>
  <div class="mb-2 flex min-w-0 flex-wrap items-center justify-between gap-x-2 gap-y-1">
    <span class="text-xs text-white sm:text-sm">{entry.degree}</span>
    <span class="text-[11px] text-[#777] sm:text-xs">{entry.dates}</span>
  </div>
  <p class="mb-2 text-xs text-accent sm:text-[13px]">{entry.school}</p>
  <p class="text-xs leading-relaxed text-[#777] sm:text-[13px]">{entry.description}</p>
</div>
