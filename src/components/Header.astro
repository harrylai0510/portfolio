---
const currentPath = Astro.url.pathname;
const navItems = [
  { href: '/work', label: 'work' },
  { href: '/education', label: 'education' },
  { href: '/projects', label: 'projects' },
];
---
<header
  class="flex h-14 w-full flex-wrap items-center justify-between gap-3 border-b border-elevated bg-bg px-4 py-3 shadow-header sm:gap-4 sm:px-6 md:h-16 md:flex-nowrap md:gap-6 md:px-8"
>
  <a href="/" class="text-xs font-semibold text-white hover:opacity-90 sm:text-sm shrink-0">
    Portfolio
  </a>
  <nav class="flex min-w-0 flex-1 flex-wrap items-center justify-end gap-4 sm:gap-5 md:flex-1 md:justify-center md:gap-6">
    {navItems.map(({ href, label }) => (
      <a
        href={href}
        class:list={[
          'text-xs transition-opacity hover:opacity-80 active:opacity-70 sm:text-sm touch-manipulation',
          currentPath === href ? 'text-white' : 'text-[#777]',
        ]}
      >
        {label}
      </a>
    ))}
  </nav>
  <a
    href="https://strapi.harrylai.com/uploads/Lai_Hon_Chung_Resume_d3bc843d5c.pdf"
    download="Lai_Hon_Chung_Resume.pdf"
    target="_blank"
    rel="noopener noreferrer"
    class="flex h-9 shrink-0 items-center justify-center rounded-xl bg-accent px-4 text-xs font-semibold text-[#0D0D0D] shadow-cta-glow transition-transform active:scale-100 hover:scale-105 touch-manipulation md:h-10 md:rounded-2xl md:px-5"
    data-analytics-event="download_resume"
    data-analytics-filename="Lai_Hon_Chung_Resume.pdf"
  >
    Download resume
  </a>
  <script is:inline>
    document.querySelector('[data-analytics-event="download_resume"]')?.addEventListener('click', function () {
      if (typeof gtag === 'function') {
        gtag('event', 'file_download', {
          file_name: this.getAttribute('data-analytics-filename') || 'resume.pdf',
          link_url: this.getAttribute('href') || '',
        });
      }
    });
  </script>
</header>
