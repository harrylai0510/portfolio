---
const links = [
  { label: 'github', href: 'https://github.com/harrylai0510' },
  { label: 'linkedin', href: 'https://www.linkedin.com/in/harrylai0510' },
];
---
<footer
  class="flex w-full flex-wrap items-center justify-center gap-4 border-t border-elevated bg-surface px-4 py-5 shadow-footer-inner sm:justify-between sm:gap-5 sm:px-6 sm:py-6 md:px-8"
>
  <span class="order-2 text-xs font-semibold text-white sm:order-1">Harry Lai - Portfolio</span>
  <div class="flex order-1 w-full justify-center gap-4 sm:order-2 sm:w-auto sm:gap-5">
    {links.map(({ label, href }) => (
      <a href={href} class="text-xs text-[#777] transition-opacity hover:opacity-80 active:opacity-70 touch-manipulation">
        {label}
      </a>
    ))}
  </div>
  <span class="order-3 text-[11px] text-[#777]">© 2025</span>
</footer>
