---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
---
<Layout title="Projects - Harry Lai - Portfolio" description="Projects">
  <div class="flex min-h-screen flex-col">
    <Header />
    <main class="flex min-w-0 flex-1 flex-col px-4 py-8 sm:px-6 sm:py-10 md:px-8 md:py-12">
      <div class="mb-4 flex flex-wrap items-center justify-between gap-3 sm:mb-6">
        <p class="text-xs text-[#777]">// projects</p>
        <div class="flex rounded-xl border border-elevated bg-surface p-1" role="tablist" aria-label="View mode">
          <button
            type="button"
            data-view-toggle="card"
            class="view-toggle flex h-9 w-9 items-center justify-center rounded-lg transition-colors touch-manipulation sm:h-10 sm:w-10"
            aria-pressed="true"
            aria-label="Card view"
          >
            <svg class="h-4 w-4 sm:h-5 sm:w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="3" width="7" height="7" rx="1" />
              <rect x="14" y="3" width="7" height="7" rx="1" />
              <rect x="3" y="14" width="7" height="7" rx="1" />
              <rect x="14" y="14" width="7" height="7" rx="1" />
            </svg>
          </button>
          <button
            type="button"
            data-view-toggle="list"
            class="view-toggle flex h-9 w-9 items-center justify-center rounded-lg transition-colors touch-manipulation sm:h-10 sm:w-10"
            aria-pressed="false"
            aria-label="List view"
          >
            <svg class="h-4 w-4 sm:h-5 sm:w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="8" y1="6" x2="21" y2="6" />
              <line x1="8" y1="12" x2="21" y2="12" />
              <line x1="8" y1="18" x2="21" y2="18" />
              <line x1="3" y1="6" x2="3.01" y2="6" />
              <line x1="3" y1="12" x2="3.01" y2="12" />
              <line x1="3" y1="18" x2="3.01" y2="18" />
            </svg>
          </button>
        </div>
      </div>
      <div id="projects-container" data-view="card">
        <div class="projects-card-view grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3">
          {projects.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
        <div class="projects-list-view hidden flex-col gap-3 sm:gap-4">
          {projects.map((project) => (
            <div class="min-w-0 rounded-2xl border border-elevated bg-surface px-4 py-4 shadow-card sm:px-5 sm:py-5">
              <div class="mb-1.5 flex min-w-0 flex-wrap items-baseline justify-between gap-x-2 gap-y-1">
                <span class="text-xs font-medium text-white sm:text-sm">{project.name}</span>
                <span class="text-[11px] text-[#777] sm:text-xs">{project.dates}</span>
              </div>
              <p class="mb-1.5 text-xs text-accent sm:text-[13px]">{project.tech}</p>
              <p class="text-xs leading-relaxed text-[#777] sm:text-[13px]">{project.description}</p>
            </div>
          ))}
        </div>
      </div>
    </main>
    <Footer />
  </div>
  <script is:inline>
    (function () {
      const container = document.getElementById('projects-container');
      const toggles = document.querySelectorAll('[data-view-toggle]');
      if (!container || !toggles.length) return;

      function setView(view) {
        container.setAttribute('data-view', view);
        toggles.forEach(function (btn) {
          const isCard = btn.getAttribute('data-view-toggle') === 'card';
          const pressed = (view === 'card' && isCard) || (view === 'list' && !isCard);
          btn.setAttribute('aria-pressed', String(pressed));
          btn.classList.toggle('bg-accent', pressed);
          btn.classList.toggle('text-[#0D0D0D]', pressed);
          btn.classList.toggle('text-[#777]', !pressed);
        });
        try {
          const url = new URL(window.location.href);
          url.searchParams.set('view', view);
          window.history.replaceState({}, '', url);
        } catch (_) {}
      }

      toggles.forEach(function (btn) {
        btn.addEventListener('click', function () {
          setView(btn.getAttribute('data-view-toggle') || 'card');
        });
      });

      const params = new URLSearchParams(window.location.search);
      const viewParam = params.get('view');
      if (viewParam === 'list' || viewParam === 'card') setView(viewParam);
      else setView('card');
    })();
  </script>
  <style is:global>
    #projects-container[data-view="list"] .projects-card-view { display: none; }
    #projects-container[data-view="list"] .projects-list-view { display: flex; }
    #projects-container[data-view="card"] .projects-list-view { display: none; }
    .view-toggle:not([aria-pressed="true"]) { background: transparent; color: #777; }
    .view-toggle[aria-pressed="true"] { background: #FF6B35; color: #0D0D0D; }
  </style>
</Layout>
